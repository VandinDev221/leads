generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SavedLead {
  id              String    @id @default(uuid())
  externalId      String    @unique
  name            String
  category        String
  categories      String    @default("")
  address         String
  city            String?
  state           String?
  country         String?   @default("Brasil")
  postalCode      String?
  latitude        Float
  longitude       Float
  distanceKm      Float?
  phone           String?
  website         String?
  whatsapp        String?
  instagram       String?
  rating          Float?
  reviewCount     Int?
  openingHours    String?
  mapsUrl         String
  source          String    @default("nominatim")
  sourceUrl       String?
  prospectStatus  String    @default("NOVO")
  notes           String?
  lastContactedAt DateTime?
  nextContactAt   DateTime?
  isFavorite      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SearchHistory {
  id           String   @id @default(uuid())
  category     String
  location     String
  radiusKm     Float
  resultsCount Int
  createdAt    DateTime @default(now())
}

model SearchCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique
  dataJson  String
  createdAt DateTime @default(now())
}
