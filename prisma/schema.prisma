generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProspectStatus {
  NOVO
  QUALIFICADO
  CONTATAR
  CONTATADO
  RESPONDEU
  INTERESSADO
  PROPOSTA
  NEGOCIACAO
  CLIENTE
  SEM_INTERESSE
  PERDIDO
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InteractionType {
  CALL
  WHATSAPP
  EMAIL
  INSTAGRAM
  MEETING
  NOTE
  STATUS_CHANGE
  PROPOSAL
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  users     User[]
  leads     SavedLead[]
  lists     LeadList[]
  searches  SavedSearch[]
  templates MessageTemplate[]
  createdAt DateTime          @default(now())
}

model SavedLead {
  id               String           @id @default(uuid())
  externalId       String           @unique
  name             String
  category         String
  categories       String           @default("")
  address          String
  city             String?
  state            String?
  country          String?          @default("Brasil")
  postalCode       String?
  latitude         Float
  longitude        Float
  distanceKm       Float?
  phone            String?
  email            String?
  website          String?
  whatsapp         String?
  instagram        String?
  facebook         String?
  rating           Float?
  reviewCount      Int?
  openingHours     String?
  mapsUrl          String
  source           String           @default("nominatim")
  sourceUrl        String?
  prospectStatus   ProspectStatus   @default(NOVO)
  priority         Priority         @default(MEDIUM)
  leadScore        Int              @default(0)
  opportunityScore Int              @default(0)
  salesPotential   String           @default("MEDIUM")
  notes            String?
  lastContactedAt  DateTime?
  nextContactAt    DateTime?
  isFavorite       Boolean          @default(false)
  workspaceId      String?
  workspace        Workspace?       @relation(fields: [workspaceId], references: [id])
  contacts         LeadContact[]
  interactions     Interaction[]
  followUps        FollowUp[]
  tasks            Task[]
  proposals        Proposal[]
  listMembers      LeadListMember[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([externalId])
  @@index([phone])
  @@index([prospectStatus])
  @@index([city])
  @@index([category])
  @@index([nextContactAt])
}

model LeadContact {
  id        String    @id @default(uuid())
  leadId    String
  lead      SavedLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String?
  email     String?
  whatsapp  String?
  instagram String?
  notes     String?
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model Interaction {
  id          String          @id @default(uuid())
  leadId      String
  lead        SavedLead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        InteractionType
  description String
  createdAt   DateTime        @default(now())
}

model FollowUp {
  id          String    @id @default(uuid())
  leadId      String
  lead        SavedLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  type        String    @default("WHATSAPP")
  notes       String?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Task {
  id          String     @id @default(uuid())
  leadId      String?
  lead        SavedLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
}

model SavedSearch {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  name        String
  category    String
  location    String
  radiusKm    Float
  filtersJson String?
  createdAt   DateTime   @default(now())
}

model LeadList {
  id          String           @id @default(uuid())
  workspaceId String?
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id])
  name        String
  description String?
  members     LeadListMember[]
  createdAt   DateTime         @default(now())
}

model LeadListMember {
  id        String    @id @default(uuid())
  listId    String
  list      LeadList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  leadId    String
  lead      SavedLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([listId, leadId])
}

model MessageTemplate {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  title       String
  channel     String     @default("WHATSAPP")
  content     String
  createdAt   DateTime   @default(now())
}

model Proposal {
  id             String         @id @default(uuid())
  leadId         String
  lead           SavedLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceName    String
  estimatedValue Float
  status         ProposalStatus @default(DRAFT)
  notes          String?
  validUntil     DateTime?
  createdAt      DateTime       @default(now())
}

model SearchHistory {
  id           String   @id @default(uuid())
  category     String
  location     String
  radiusKm     Float
  resultsCount Int
  createdAt    DateTime @default(now())
}

model SearchCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique
  dataJson  String
  createdAt DateTime @default(now())
}
